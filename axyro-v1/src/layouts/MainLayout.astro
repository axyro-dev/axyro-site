---
import Navbar from "../components/Navbar.astro";

const { title = "AXYRO" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <title>{title}</title>

    <link rel="icon" type="image/png" href="/favicon.png" />

    <style is:global>
      :root {
        color-scheme: dark;

        --axyro-heading-weight: 560;
        --axyro-body-weight: 400;

        --axyro-heading-line: 0.92;
        --axyro-heading-spacing: -0.08em;
        --axyro-body-line: 1.72;

        --axyro-radius-large: 28px;
        --axyro-radius-medium: 22px;

        --axyro-h1: clamp(64px, 7vw, 118px);
        --axyro-h2: clamp(42px, 4.8vw, 72px);
        --axyro-h3: 32px;
        --axyro-body: 19px;
        --axyro-small: 13px;

        --axyro-section-padding:
          104px clamp(32px, 7vw, 120px) 118px;

        --axyro-section-padding-mobile:
          82px 24px 92px;

        --axyro-bg: #020407;
        --axyro-bg-deep: #05070A;
        --axyro-surface: #030712;

        --axyro-text: #F5F7FA;
        --axyro-muted: rgba(245,247,250,0.56);
        --axyro-faint: rgba(245,247,250,0.34);

        --axyro-blue: #A7D8FF;
        --axyro-blue-soft: rgba(167,216,255,0.18);
        --axyro-blue-faint: rgba(167,216,255,0.07);

        --axyro-line: rgba(255,255,255,0.055);
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        margin: 0;

        background:
          radial-gradient(
            circle at 72% 8%,
            rgba(167,216,255,0.035),
            transparent 28%
          ),
          var(--axyro-bg);

        color: var(--axyro-text);

        font-family:
          Inter,
          system-ui,
          sans-serif;

        overflow-x: hidden;
        scroll-behavior: smooth;
      }

      body {
        position: relative;
      }

      body > *:not(.ambient-grid) {
        position: relative;
        z-index: 1;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      ::selection {
        background: rgba(167,216,255,0.18);
        color: var(--axyro-text);
      }

      h1,
      h2,
      h3,
      h4 {
        margin: 0;

        font-weight:
          var(--axyro-heading-weight);

        color:
          var(--axyro-text);
      }

      p {
        margin: 0;
      }

      .ambient-grid {
        position: fixed;
        inset: 0;

        pointer-events: none;
        z-index: 0;

        opacity: 0.18;

        background:
          linear-gradient(
            rgba(255,255,255,0.015) 1px,
            transparent 1px
          ),
          linear-gradient(
            90deg,
            rgba(255,255,255,0.015) 1px,
            transparent 1px
          );

        background-size: 140px 140px;

        mask-image:
          radial-gradient(
            circle at center,
            black 20%,
            transparent 82%
          );
      }

      .reveal {
        opacity: 0;
        transform: translateY(18px);

        transition:
          opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
          transform 1.2s cubic-bezier(0.22, 1, 0.36, 1);
      }

      .reveal.visible {
        opacity: 1;
        transform: translateY(0);
      }

      .reveal-delay-1 {
        transition-delay: 0.08s;
      }

      .reveal-delay-2 {
        transition-delay: 0.16s;
      }

      .reveal-delay-3 {
        transition-delay: 0.24s;
      }

      .reveal-delay-4 {
        transition-delay: 0.32s;
      }

      .axyro-card {
        position: relative;

        overflow: hidden;

        border-radius: var(--axyro-radius-large);

        background:
          linear-gradient(
            180deg,
            rgba(255,255,255,0.018),
            rgba(255,255,255,0.006)
          );

        border:
          1px solid rgba(255,255,255,0.035);

        backdrop-filter: blur(10px);

        transition:
          transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
          border-color 0.6s ease,
          background 0.6s ease,
          box-shadow 0.6s ease;
      }

      .axyro-card::before {
        content: "";

        position: absolute;
        left: 0;
        right: 0;
        top: 0;

        height: 1px;

        background:
          linear-gradient(
            90deg,
            transparent,
            rgba(167,216,255,0.14),
            transparent
          );

        opacity: 0.22;
      }

      .axyro-card:hover {
        transform: translateY(-4px);

        border-color:
          rgba(167,216,255,0.08);

        background:
          linear-gradient(
            180deg,
            rgba(255,255,255,0.026),
            rgba(255,255,255,0.01)
          );

        box-shadow:
          0 20px 80px rgba(0,0,0,0.28),
          0 0 42px rgba(167,216,255,0.035);
      }

      .axyro-image {
        position: relative;

        overflow: hidden;

        transform: translateZ(0);
      }

      .axyro-image img {
        transition:
          transform 1.8s cubic-bezier(.19, 1, .22, 1),
          filter 1.8s ease;

        will-change:
          transform,
          filter;
      }

      .axyro-image:hover img {
        transform: scale(1.03);

        filter:
          brightness(1.03)
          contrast(1.04)
          saturate(0.92);
      }

      @media (prefers-reduced-motion: reduce) {
        .reveal {
          opacity: 1;
          transform: none;
          transition: none;
        }

        .reveal-delay-1,
        .reveal-delay-2,
        .reveal-delay-3,
        .reveal-delay-4 {
          transition-delay: 0s;
        }

        .axyro-image img {
          transition: none;
        }
      }
    </style>
  </head>

  <body>
    <div class="ambient-grid"></div>

    <Navbar />

    <slot />

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("visible");
            }
          });
        },
        {
          threshold: 0.08,
        }
      );

      document.querySelectorAll(".reveal").forEach((el) => {
        observer.observe(el);
      });
    </script>
  </body>
</html>