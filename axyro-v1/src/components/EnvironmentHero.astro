---
const {
  type,
  title,
  subtitle,
  image
} = Astro.props;
---

<section class="environment-hero reveal">
  <div
    class="image"
    style={`background-image:
      linear-gradient(
        90deg,
        rgba(2,4,7,0.90) 0%,
        rgba(2,4,7,0.62) 34%,
        rgba(2,4,7,0.20) 60%,
        rgba(2,4,7,0.82) 100%
      ),
      linear-gradient(
        180deg,
        rgba(2,4,7,0.22) 0%,
        rgba(2,4,7,0.04) 44%,
        rgba(2,4,7,0.92) 100%
      ),
      url(${image})`}
  ></div>

  <div class="haze"></div>

  <div class="content">
    <p class="eyebrow">{type}</p>

    <h1>{title}</h1>

    <p class="sub">{subtitle}</p>
  </div>

  <span class="phase">
    AXYRO ENVIRONMENT ARCHIVE
  </span>
</section>

<style>
  .environment-hero {
    position: relative;
    min-height: 82vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    background: #020407;
  }

  .image {
    position: absolute;
    inset: 0;
    z-index: 0;

    background-size: cover;
    background-position: center 58%;
    background-repeat: no-repeat;

    filter:
      brightness(0.78)
      contrast(1.04)
      saturate(0.72);
      transform: scale(1.014);
      will-change: transform;

      transition:
      transform 0.9s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .haze {
    position: absolute;
    inset: 0;
    z-index: 1;

    background:
      radial-gradient(
        ellipse at 54% 48%,
        rgba(167,216,255,0.055),
        transparent 34%
      ),
      radial-gradient(
        ellipse at 58% 60%,
        rgba(245,247,250,0.025),
        transparent 40%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(2,4,7,0.16) 62%,
        rgba(2,4,7,0.88) 100%
      );

    opacity: 0.46;
    pointer-events: none;
  }

  .environment-hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;

    background:
      radial-gradient(
        circle at center,
        transparent 42%,
        rgba(0,0,0,0.46) 100%
      );

    pointer-events: none;
  }

  .environment-hero::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: 138px;
    z-index: 2;

    width: 58vw;
    max-width: 980px;
    height: 1px;

    transform: translateX(-50%);

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(167,216,255,0.18),
        transparent
      );

    opacity: 0.10;
    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 3;
    width: min(800px, 90vw);
    margin-left: clamp(42px, 8vw, 150px);
    margin-top: -18px;
  }

  .eyebrow {
    margin: 0 0 30px;
    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;
    color: rgba(167,216,255,0.68);
  }

  h1 {
    margin: 0;
    font-size: clamp(68px, 8vw, 116px);
    line-height: 0.9;
    letter-spacing: -0.075em;
    font-weight: 380;
    color: rgba(245,247,250,0.96);
  }

  .sub {
    margin-top: 34px;
    max-width: 560px;
    font-size: 19px;
    line-height: 1.72;
    color: rgba(245,247,250,0.52);
  }

  .phase {
    position: absolute;
    right: clamp(32px, 7vw, 120px);
    bottom: 44px;
    z-index: 3;

    font-size: 10px;
    letter-spacing: 0.44em;
    text-transform: uppercase;
    color: rgba(245,247,250,0.22);
  }

  @media (max-width: 900px) {
    .environment-hero {
      min-height: 700px;
    }

    .content {
      margin-left: 24px;
      margin-right: 24px;
      margin-top: 20px;
    }

    h1 {
      font-size: clamp(60px, 16vw, 82px);
    }

    .sub {
      font-size: 18px;
    }

    .phase {
      left: 24px;
      right: 24px;
      line-height: 1.8;
    }
  }
</style>
<script is:inline>
  const hero = document.querySelector(".environment-hero");
  const image = document.querySelector(".image");

  if (hero && image) {
    hero.addEventListener("mousemove", (e) => {
      const x = (e.clientX / window.innerWidth - 0.5) * 10;
      const y = (e.clientY / window.innerHeight - 0.5) * 10;

      image.style.transform = `
        scale(1.02)
        translate3d(${x * 0.4}px, ${y * 0.4}px, 0)
      `;
    });

    hero.addEventListener("mouseleave", () => {
      image.style.transform = `
        scale(1.014)
        translate3d(0px, 0px, 0)
      `;
    });
  }
</script>