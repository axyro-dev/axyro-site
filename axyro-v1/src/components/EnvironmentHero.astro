---
const {
  type,
  title,
  subtitle,
  image
} = Astro.props;
---

<section class="environment-hero reveal">
  <div
    class="image"
    style={`background-image:
      linear-gradient(
        90deg,
        rgba(2,4,7,0.88) 0%,
        rgba(2,4,7,0.56) 38%,
        rgba(2,4,7,0.20) 62%,
        rgba(2,4,7,0.76) 100%
      ),
      linear-gradient(
        180deg,
        rgba(2,4,7,0.34) 0%,
        rgba(2,4,7,0.10) 42%,
        rgba(2,4,7,0.90) 100%
      ),
      url(${image})`}
  ></div>

  <div class="haze"></div>

  <div class="content">
    <p class="eyebrow">{type}</p>

    <h1>{title}</h1>

    <p class="sub">{subtitle}</p>
  </div>

  <span class="phase">
    AXYRO ENVIRONMENT ARCHIVE
  </span>
</section>

<style>
  .environment-hero {
    position: relative;

    min-height: 780px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background: #020407;
  }

  .image {
    position: absolute;
    inset: 0;
    z-index: 0;

    background-size: cover;
    background-position: center;

    filter:
      brightness(0.86)
      contrast(1.14)
      saturate(0.84);

    transform: scale(1.014);
  }

  .haze {
    position: absolute;
    inset: 0;
    z-index: 1;

    background:
      radial-gradient(
        ellipse at 54% 48%,
        rgba(167,216,255,0.095),
        transparent 32%
      ),
      radial-gradient(
        ellipse at 58% 60%,
        rgba(245,247,250,0.04),
        transparent 38%
      ),
      linear-gradient(
        180deg,
        transparent 0%,
        rgba(2,4,7,0.18) 62%,
        rgba(2,4,7,0.86) 100%
      );

    opacity: 0.72;

    pointer-events: none;
  }

  .environment-hero::before {
    content: "";

    position: absolute;
    inset: 0;
    z-index: 2;

    background:
      radial-gradient(
        circle at center,
        transparent 38%,
        rgba(0,0,0,0.50) 100%
      );

    pointer-events: none;
  }

  .environment-hero::after {
    content: "";

    position: absolute;
    left: 50%;
    bottom: 176px;
    z-index: 2;

    width: 60vw;
    max-width: 1020px;
    height: 1px;

    transform: translateX(-50%);

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(167,216,255,0.24),
        transparent
      );

    opacity: 0.22;

    pointer-events: none;
  }

  .content {
    position: relative;
    z-index: 3;

    width: min(800px, 90vw);

    margin-left: clamp(32px, 7vw, 120px);
    margin-top: -36px;
  }

  .eyebrow {
    margin: 0 0 30px;

    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;

    color: rgba(167,216,255,0.78);
  }

  h1 {
    margin: 0;

    font-size: clamp(72px, 9vw, 132px);
    line-height: 0.88;
    letter-spacing: -0.085em;
    font-weight: 560;

    color: rgba(245,247,250,0.98);
  }

  .sub {
    margin-top: 34px;

    max-width: 560px;

    font-size: 20px;
    line-height: 1.72;

    color: rgba(245,247,250,0.58);
  }

  .phase {
    position: absolute;
    right: clamp(32px, 7vw, 120px);
    bottom: 44px;
    z-index: 3;

    font-size: 10px;
    letter-spacing: 0.44em;
    text-transform: uppercase;

    color: rgba(245,247,250,0.26);
  }

  @media (max-width: 900px) {
    .environment-hero {
      min-height: 700px;
    }

    .content {
      margin-top: 20px;
    }

    h1 {
      font-size: clamp(64px, 17vw, 86px);
    }

    .sub {
      font-size: 18px;
    }

    .phase {
      left: 24px;
      right: 24px;

      line-height: 1.8;
    }
  }
</style>