<script is:inline>
  const hero = document.querySelector(".hero-content");

  if (hero) {
    window.addEventListener("scroll", () => {
      const offset = window.scrollY * 0.12;

      hero.style.transform =
        `translate3d(0, ${offset}px, 0)`;
    });
  }
</script>