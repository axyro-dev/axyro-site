---
const {
  title = "Blue Horizon",
  subtitle = "Designed for focused systems, calm workspaces and restrained digital environments.",

  desktopHref = "/wallpapers/axyro_blue_horizon_v2_4kd.png",
  mobileHref = "/wallpapers/axyro_blue_horizon_mobile_v2_4kd.png",
} = Astro.props;
---

<section class="download">
  <div class="download-content">
    <p class="label">ENVIRONMENT ACCESS</p>

    <h2>
      Bring {title}
      into your workflow.
    </h2>

    <p class="download-sub">
      {subtitle}
    </p>

    <div class="downloads">
      <a class="download-card primary" href={desktopHref} download>
        <span class="type">DESKTOP</span>

        <h3>4K Environment</h3>

        <p>
          3840 × 2160 · PNG
        </p>
      </a>

      <a class="download-card" href={mobileHref} download>
        <span class="type">MOBILE</span>

        <h3>Vertical Environment</h3>

        <p>
          2160 × 3840 · PNG
        </p>
      </a>
    </div>
  </div>
</section>

<style>
  .download {
    position: relative;

    padding:
      140px
      clamp(48px, 7vw, 120px)
      180px;

    overflow: hidden;

    background:
      linear-gradient(
        180deg,
        #020407 0%,
        #05070A 100%
      );
  }

  .download::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at center,
        rgba(142,223,255,0.04),
        transparent 42%
      );

    pointer-events: none;
  }

  .download-content {
    position: relative;
    z-index: 2;

    max-width: 1100px;
  }

  .label {
    margin: 0 0 24px;

    font-size: 11px;
    letter-spacing: 0.34em;
    text-transform: uppercase;

    color:
      rgba(142,223,255,0.82);
  }

  h2 {
    margin: 0;

    max-width: 820px;

    font-size:
      clamp(46px, 5vw, 76px);

    line-height: 0.94;
    letter-spacing: -0.08em;

    color: #F5F7FA;
  }

  .download-sub {
    margin-top: 34px;

    max-width: 620px;

    font-size: 20px;
    line-height: 1.8;

    color:
      rgba(245,247,250,0.56);
  }

  .downloads {
    display: grid;

    grid-template-columns:
      1fr
      1fr;

    gap: 24px;

    margin-top: 64px;
  }

  .download-card {
    position: relative;

    padding:
      38px
      38px
      42px;

    border-radius: 30px;

    overflow: hidden;

    text-decoration: none;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.014),
        rgba(255,255,255,0.004)
      );

    border:
      1px solid rgba(255,255,255,0.03);

    transition:
      transform 0.7s cubic-bezier(.19,1,.22,1),
      border-color 0.7s ease,
      background 0.7s ease;
  }

  .download-card:hover {
    transform:
      translateY(-4px);

    border-color:
      rgba(142,223,255,0.07);
  }

  .download-card::before {
    content: "";

    position: absolute;
    inset: 0;

    background:
      radial-gradient(
        circle at top,
        rgba(142,223,255,0.04),
        transparent 60%
      );

    opacity: 0;

    transition: opacity 0.7s ease;
  }

  .download-card:hover::before {
    opacity: 1;
  }

  .type {
    position: relative;
    z-index: 2;

    display: block;

    font-size: 10px;
    letter-spacing: 0.34em;
    text-transform: uppercase;

    color:
      rgba(142,223,255,0.76);
  }

  h3 {
    position: relative;
    z-index: 2;

    margin:
      18px 0 0;

    font-size:
      clamp(28px, 2.4vw, 40px);

    line-height: 0.96;
    letter-spacing: -0.06em;

    color: #F5F7FA;
  }

  .download-card p {
    position: relative;
    z-index: 2;

    margin:
      16px 0 0;

    font-size: 15px;
    line-height: 1.7;

    color:
      rgba(245,247,250,0.5);
  }

  @media (max-width: 820px) {
    .downloads {
      grid-template-columns: 1fr;
    }

    .download {
      padding:
        110px
        24px
        140px;
    }

    h2 {
      font-size:
        clamp(42px, 13vw, 64px);
    }
  }
</style>