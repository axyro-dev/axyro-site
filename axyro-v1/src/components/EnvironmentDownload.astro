---
const {
  title = "Blue Horizon",
  subtitle = "Designed for focused systems, calm workspaces and restrained digital environments.",
  primaryHref = "/",
  secondaryHref = "/environments",
} = Astro.props;
---

<section class="download">
  <div class="download-content">
    <p class="label">Environment Access</p>

    <h2>
      Bring {title}
      into your workflow.
    </h2>

    <p class="download-sub">
      {subtitle}
    </p>

    <div class="download-actions">
      <a class="primary" href={primaryHref}>Download Environment</a>
      <a class="secondary" href={secondaryHref}>View all environments</a>
    </div>
  </div>
</section>

<style>
  .download {
    position: relative;
    padding: 140px clamp(48px, 7vw, 120px) 180px;
    overflow: hidden;
    background:
      linear-gradient(
        180deg,
        #020407 0%,
        #05070a 100%
      );
  }

  .download::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        circle at center,
        rgba(142, 223, 255, 0.05),
        transparent 42%
      );
    pointer-events: none;
  }

  .download-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
  }

  .label {
    margin: 0 0 26px;
    font-size: 12px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(142, 223, 255, 0.88);
  }

  h2 {
    margin: 18px 0 0;
    max-width: 820px;
    font-size: clamp(42px, 5vw, 72px);
    line-height: 0.96;
    letter-spacing: -0.07em;
    color: #f5f7fa;
  }

  .download-sub {
    margin-top: 34px;
    max-width: 620px;
    font-size: 22px;
    line-height: 1.8;
    color: rgba(245, 247, 250, 0.58);
  }

  .download-actions {
    display: flex;
    gap: 18px;
    margin-top: 52px;
  }

  .download-actions a {
    padding: 18px 30px;
    border-radius: 999px;
    font-size: 15px;
    transition:
      transform 0.7s cubic-bezier(0.22, 1, 0.36, 1),
      border-color 0.7s ease,
      box-shadow 0.7s ease,
      background 0.7s ease;
  }

  .download-actions a:hover {
    transform: translateY(-2px);
  }

  .primary {
    background: #f5f7fa;
    color: #020407;
  }

  .secondary {
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: rgba(245, 247, 250, 0.88);
  }
</style>