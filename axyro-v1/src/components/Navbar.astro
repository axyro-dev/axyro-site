<header class="nav">
  
 <a href="/" class="logo">
  <div class="logo-tile">
    <img src="/icons/axyro-tile.png" alt="AXYRO" />
  </div>

  <span class="logo-text">AXYRO</span>
</a>

  <nav class="links">
    <a href="/">Overview</a>
    <a href="/environments">Environments</a>
    <a href="/philosophy">Philosophy</a>
    <a href="/design">Design</a>
    <a href="/journal">Journal</a>
  </nav>

  <div class="nav-spacer"></div>

  <!-- Support button disabled for V1
  <a class="cta" href="/support">
    Support AXYRO
  </a>
  -->
</header>

<style>
  .nav {
    position: fixed;
    top: 18px;
    left: 24px;
    right: 24px;
    height: 64px;
    z-index: 1000;

    display: grid;
    grid-template-columns: 220px 1fr 220px;
    align-items: center;

    padding: 0 26px;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.035),
        rgba(255,255,255,0.012)
      );

    backdrop-filter: blur(18px);
    border: 1px solid rgba(255,255,255,0.035);
    border-radius: 18px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.28);

    transition:
      background 0.45s ease,
      border-color 0.45s ease,
      box-shadow 0.45s ease,
      top 0.45s ease;
  }

  .nav.scrolled {
    top: 14px;

    background:
      linear-gradient(
        180deg,
        rgba(255,255,255,0.05),
        rgba(255,255,255,0.018)
      );

    border-color: rgba(167,216,255,0.08);
    box-shadow: 0 18px 60px rgba(0,0,0,0.34);
  }

  .nav a,
  .nav a:visited,
  .nav a:hover {
    text-decoration: none;
  }

  .brand-lockup {
    display: flex;
    align-items: center;
    gap: 14px;
    justify-self: start;
  }

  .brand-symbol {
    font-size: 14px;
    font-weight: 560;
    letter-spacing: -0.04em;
    color: rgba(245,247,250,0.94);
  }

  .brand-divider {
    width: 1px;
    height: 14px;

    background:
      linear-gradient(
        180deg,
        transparent,
        rgba(255,255,255,0.16),
        transparent
      );

    opacity: 0.45;
  }

  .brand-wordmark {
    font-size: 10px;
    letter-spacing: 0.52em;
    text-transform: uppercase;
    color: rgba(245,247,250,0.78);
  }

  .links {
    display: flex;
    justify-content: center;
    gap: 42px;
    margin: 0;
  }

  .links a {
    position: relative;

    font-size: 12px;
    font-weight: 400;
    letter-spacing: -0.01em;

    color: rgba(245,247,250,0.72);

    transition:
      color 0.35s ease,
      opacity 0.35s ease;
  }

  .links a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -10px;

    width: 100%;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        rgba(167,216,255,0),
        rgba(167,216,255,0.52),
        rgba(167,216,255,0)
      );

    opacity: 0;
    transform: scaleX(0.6);

    transition:
      opacity 0.35s ease,
      transform 0.35s ease;
  }

  .links a:hover {
    color: rgba(245,247,250,0.94);
  }

  .links a:hover::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .nav-spacer {
    justify-self: end;
    width: 220px;
    height: 1px;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    height: 40px;
    padding: 0 18px;

    border-radius: 999px;
    background: rgba(255,255,255,0.035);
    border: 1px solid rgba(255,255,255,0.08);

    color: rgba(245,247,250,0.86);

    font-size: 12px;
    letter-spacing: 0.01em;

    transition:
      background 0.35s ease,
      border-color 0.35s ease,
      transform 0.35s ease,
      box-shadow 0.35s ease;
  }

  .cta:hover {
    transform: translateY(-1px);
    background: rgba(255,255,255,0.09);
    border-color: rgba(167,216,255,0.14);
    box-shadow: 0 0 24px rgba(167,216,255,0.06);
  }

  @media (max-width: 980px) {
    .nav {
      display: flex;
      justify-content: space-between;
    }

    .links,
    .nav-spacer {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .nav {
      left: 14px;
      right: 14px;
      padding: 0 18px;
    }

    .brand-wordmark {
      letter-spacing: 0.36em;
    }
  }

 .logo {
  display: flex;
  align-items: center;
  gap: 16px;
}

.logo-tile {
   width: 38px;
  height: 38px;
  border-radius: 10px;
  overflow: hidden;
  background: #050A10;
  border: 1px solid rgba(255,255,255,0.025);
  box-shadow: none;

  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-tile img {
   width: 84%;
  height: 84%;
  object-fit: cover;
}

.logo-text {
  font-size: 10px;
  letter-spacing: 0.46em;
  text-transform: uppercase;
  color: rgba(245,247,250,0.78);
}
</style>

<script>
  const nav = document.querySelector(".nav");

  if (nav) {
    window.addEventListener("scroll", () => {
      if (window.scrollY > 24) {
        nav.classList.add("scrolled");
      } else {
        nav.classList.remove("scrolled");
      }
    });
  }
</script>