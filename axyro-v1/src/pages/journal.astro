---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="Journal — AXYRO">
  <main class="journal-page">
    <section class="hero">
      <p class="eyebrow">AXYRO JOURNAL</p>

      <h1>
        Journal
      </h1>

      <p class="sub">
        Notes on calm compute, environments and restrained systems.
      </p>

      <span class="phase">
        JOURNAL ARCHIVE / EARTH PHASE
      </span>
    </section>

    <section class="entries">
      <a class="entry" href="/journal/reduce-noise">
        <span>01</span>

        <div>
          <h2>Reduce noise.</h2>
          <p>Why focused systems begin with silence.</p>
        </div>
      </a>

      <a class="entry" href="/journal/environment-layer">
        <span>02</span>

        <div>
          <h2>The environment layer.</h2>
          <p>Building atmosphere before claiming a platform.</p>
        </div>
      </a>

      <a class="entry" href="/journal/controlled-darkness">
        <span>03</span>

        <div>
          <h2>Controlled darkness.</h2>
          <p>Darkness as structure rather than aesthetic.</p>
        </div>
      </a>

      <a class="entry" href="/journal/quiet-systems">
        <span>04</span>

        <div>
          <h2>Quiet systems feel faster.</h2>
          <p>Calm interaction creates stronger control.</p>
        </div>
      </a>
    </section>

    <section class="notes">
      <div class="line"></div>

      <span>
        JOURNAL ARCHIVE / EARTH PHASE
      </span>
    </section>
  </main>
</MainLayout>

<style>
  .journal-page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 72% 12%,
        rgba(167,216,255,0.03),
        transparent 34%
      ),
      linear-gradient(
        180deg,
        #020407 0%,
        #030712 100%
      );
  }

  .hero {
    padding:
      230px
      clamp(32px, 7vw, 120px)
      110px;
  }

  .eyebrow {
    margin: 0 0 28px;

    font-size: 11px;
    letter-spacing: 0.42em;
    text-transform: uppercase;

    color: rgba(167,216,255,0.76);
  }

  h1 {
    margin: 0;

    font-size: clamp(82px, 9vw, 140px);
    line-height: 0.86;
    letter-spacing: -0.09em;
    font-weight: 560;

    color: rgba(245,247,250,0.98);
  }

  .sub {
    margin-top: 34px;

    max-width: 560px;

    font-size: 19px;
    line-height: 1.72;

    color: rgba(245,247,250,0.56);
  }

  .phase {
    display: inline-flex;

    margin-top: 58px;

    font-size: 10px;
    letter-spacing: 0.44em;
    text-transform: uppercase;

    color: rgba(245,247,250,0.28);
  }

  .entries {
    padding:
      0
      clamp(32px, 7vw, 120px)
      130px;
  }

  .entry {
    position: relative;

    display: grid;
    grid-template-columns: 90px 1fr;

    padding: 42px 0;

    border-top:
      1px solid rgba(255,255,255,0.035);

    color: inherit;
    text-decoration: none;
  }

  .entry:last-child {
    border-bottom:
      1px solid rgba(255,255,255,0.035);
  }

  .entry::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -1px;

    width: 100%;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        rgba(167,216,255,0.18),
        transparent
      );

    opacity: 0;

    transition: opacity 0.35s ease;
  }

  .entry:hover::after {
    opacity: 1;
  }

  .entry span {
    font-size: 10px;
    letter-spacing: 0.34em;

    color: rgba(245,247,250,0.26);
  }

  .entry h2 {
    margin: 0;

    font-size: clamp(34px, 4vw, 68px);
    line-height: 0.94;
    letter-spacing: -0.08em;
    font-weight: 560;

    color: rgba(245,247,250,0.96);
  }

  .entry p {
    margin: 20px 0 0;

    max-width: 620px;

    font-size: 18px;
    line-height: 1.72;

    color: rgba(245,247,250,0.52);
  }

  .notes {
    padding:
      0
      clamp(32px, 7vw, 120px)
      72px;
  }

  .line {
    width: 100%;
    height: 1px;

    background:
      linear-gradient(
        90deg,
        transparent,
        rgba(167,216,255,0.14),
        transparent
      );

    opacity: 0.22;
  }

  .notes span {
    display: inline-flex;

    margin-top: 28px;

    font-size: 10px;
    letter-spacing: 0.44em;
    text-transform: uppercase;

    color: rgba(245,247,250,0.22);
  }

  @media (max-width: 760px) {
    .hero {
      padding:
        170px
        24px
        92px;
    }

    .entries,
    .notes {
      padding-left: 24px;
      padding-right: 24px;
    }

    .entry {
      grid-template-columns: 1fr;
      gap: 22px;
    }

    h1 {
      font-size: clamp(64px, 18vw, 96px);
    }
  }
</style>