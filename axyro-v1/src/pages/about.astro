---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="About — AXYRO">
  <main class="about-page">
    <section class="hero reveal">
      <p class="eyebrow">ABOUT AXYRO</p>

      <h1>
        A quieter way<br />
        to interact with machines.
      </h1>

      <p class="sub">
        AXYRO is a visual system focused on clarity,
        restraint and cognitive calm.
      </p>
    </section>

    <section class="principles reveal">
      <div class="left">
        <p class="label">CORE PRINCIPLES</p>
      </div>

      <div class="right">
        <div class="principle reveal reveal-delay-1">
          <h2>Calm compute</h2>

          <p>
            Systems should reduce pressure instead of increasing stimulation.
          </p>
        </div>

        <div class="principle reveal reveal-delay-2">
          <h2>Reduced stimulation</h2>

          <p>
            Less visual aggression creates stronger long-term focus.
          </p>
        </div>

        <div class="principle reveal reveal-delay-3">
          <h2>Atmospheric systems</h2>

          <p>
            Environment shapes cognition before interaction begins.
          </p>
        </div>

        <div class="principle reveal reveal-delay-4">
          <h2>Focused interaction</h2>

          <p>
            Clarity emerges when unnecessary interface tension disappears.
          </p>
        </div>
      </div>
    </section>

    <section class="values reveal">
      <p class="eyebrow">WHAT AXYRO VALUES</p>

      <div class="values-grid">
        <span>Clarity over novelty.</span>
        <span>Restraint over stimulation.</span>
        <span>Space over density.</span>
        <span>Calm over urgency.</span>
      </div>
    </section>
  </main>
</MainLayout>

<style>
  .about-page {
    min-height: 100vh;

    background:
      radial-gradient(
        circle at 72% 18%,
        rgba(167,216,255,0.025),
        transparent 36%
      ),
      linear-gradient(
        180deg,
        #020407 0%,
        #030712 100%
      );
  }

  .hero {
    padding:
      260px
      clamp(32px, 8vw, 160px)
      140px;
  }

  .eyebrow,
  .label {
    margin: 0 0 32px;

    font-size: 11px;
    letter-spacing: 0.44em;
    text-transform: uppercase;

    color: rgba(167,216,255,0.72);
  }

  h1 {
    margin: 0;

    max-width: 980px;

    font-size: clamp(72px, 8vw, 132px);
    line-height: 0.9;
    letter-spacing: -0.08em;
    font-weight: 420;

    color: rgba(245,247,250,0.96);
  }

  .sub {
    margin-top: 36px;

    max-width: 620px;

    font-size: 20px;
    line-height: 1.72;

    color: rgba(245,247,250,0.52);
  }

  .principles {
    display: grid;

    grid-template-columns: 320px 1fr;

    gap: clamp(48px, 8vw, 120px);

    padding:
      0
      clamp(32px, 8vw, 160px)
      140px;
  }

  .right {
    display: grid;
    gap: 72px;
  }

  .principle h2 {
    margin: 0 0 16px;

    font-size: clamp(34px, 4vw, 64px);
    line-height: 0.94;
    letter-spacing: -0.06em;
    font-weight: 430;

    color: rgba(245,247,250,0.92);
  }

  .principle p {
    max-width: 520px;

    font-size: 18px;
    line-height: 1.72;

    color: rgba(245,247,250,0.48);
  }

  .values {
    padding:
      0
      clamp(32px, 8vw, 160px)
      160px;
  }

  .values-grid {
    display: grid;
    gap: 20px;

    margin-top: 48px;

    max-width: 1200px;
  }

  .values-grid span {
    font-size: clamp(44px, 5vw, 84px);
    line-height: 0.96;
    letter-spacing: -0.075em;
    font-weight: 540;

    color: rgba(245,247,250,0.16);
  }

  @media (max-width: 900px) {
    .principles {
      grid-template-columns: 1fr;
    }

    .right {
      gap: 56px;
    }
  }

  @media (max-width: 720px) {
    .hero {
      padding:
        180px
        24px
        92px;
    }

    .principles,
    .values {
      padding-left: 24px;
      padding-right: 24px;
    }

    h1 {
      font-size: clamp(58px, 16vw, 88px);
    }

    .values-grid span {
      font-size: clamp(42px, 12vw, 64px);
    }
  }
</style>